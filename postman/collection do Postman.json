{
  "info": {
    "name": "SAP Integration Suite Learning",
    "description": "Coleção de testes dos laboratórios do projeto SAP Integration Suite Learning.\n\nUse variáveis de ambiente para não expor credenciais:\n- {{base_url}} = URL base do runtime (ex: https://SEU-TENANT.it-cpitrial06-rt.cfapps.us10-001.hana.ondemand.com)\n- {{clientid}} = clientid da Service Key (Process Integration Runtime / integration-flow)\n- {{clientsecret}} = clientsecret da Service Key\n\nAutenticação: Basic Auth (clientid/clientsecret) definida no nível da coleção.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{clientid}}", "type": "string" },
      { "key": "password", "value": "{{clientsecret}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "https://SEU-TENANT.it-cpitrial06-rt.cfapps.us10-001.hana.ondemand.com", "type": "string" },
    { "key": "clientid", "value": "", "type": "string" },
    { "key": "clientsecret", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Bloco A - CPI Fundamentos",
      "item": [
        {
          "name": "A1 - HTTP to Webhook",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/http/lab01", "host": ["{{base_url}}"], "path": ["http", "lab01"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"1001\",\n  \"nome\": \"Orlando\",\n  \"produto\": \"Balança Industrial\",\n  \"quantidade\": 5\n}"
            },
            "description": "Envia um JSON simples que o iFlow ajusta (Content Modifier) e encaminha ao Webhook.site."
          }
        },
        {
          "name": "A3 - Message Mapping (JSON to XML)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/http/a3mapping", "host": ["{{base_url}}"], "path": ["http", "a3mapping"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pedido\": {\n    \"numero\": \"PED-1001\",\n    \"cliente\": \"Orlando Caetano\",\n    \"valor\": \"2500.00\"\n  }\n}"
            },
            "description": "Envia um pedido em JSON que é convertido para XML e mapeado para a estrutura <Order>."
          }
        },
        {
          "name": "A4 - Groovy Script",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/http/a4groovy", "host": ["{{base_url}}"], "path": ["http", "a4groovy"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pedido\": \"PED-2001\",\n  \"cliente\": \"Orlando Caetano\",\n  \"material\": \"Balança Industrial BK-3000\",\n  \"quantidade\": 5,\n  \"valorUnitario\": 700.00,\n  \"centro\": \"1000\"\n}"
            },
            "description": "Envia um pedido simples que o Groovy enriquece (ICMS, total, classificação, rastreamento)."
          }
        }
      ],
      "description": "A2 (Timer to API) não possui sender HTTP: é disparado por Timer, portanto não há requisição no Postman."
    },
    {
      "name": "Bloco B - Padrões de Integração",
      "item": [
        {
          "name": "B1 - Router (ALTO valor)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/http/b1router", "host": ["{{base_url}}"], "path": ["http", "b1router"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pedido\": {\n    \"numero\": \"PED-3001\",\n    \"cliente\": \"Orlando\",\n    \"valor\": 5000\n  }\n}"
            },
            "description": "valor 5000 -> rota ALTO_VALOR (>= 4000)."
          }
        },
        {
          "name": "B1 - Router (MEDIO valor)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/http/b1router", "host": ["{{base_url}}"], "path": ["http", "b1router"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pedido\": {\n    \"numero\": \"PED-3002\",\n    \"cliente\": \"Orlando\",\n    \"valor\": 2000\n  }\n}"
            },
            "description": "valor 2000 -> rota MEDIO_VALOR (>= 1500 e < 4000)."
          }
        },
        {
          "name": "B1 - Router (BAIXO valor)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/http/b1router", "host": ["{{base_url}}"], "path": ["http", "b1router"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pedido\": {\n    \"numero\": \"PED-3003\",\n    \"cliente\": \"Orlando\",\n    \"valor\": 500\n  }\n}"
            },
            "description": "valor 500 -> rota Default (BAIXO_VALOR)."
          }
        },
        {
          "name": "B2 - Content Enricher",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/http/b2enricher", "host": ["{{base_url}}"], "path": ["http", "b2enricher"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pedido\": {\n    \"numero\": \"PED-4001\",\n    \"produto\": \"Balança Industrial\",\n    \"quantidade\": 3\n  }\n}"
            },
            "description": "Pedido simples enriquecido com dados de cliente via lookup OData V4 (Northwind)."
          }
        },
        {
          "name": "B3 - Splitter",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/http/b3splitter", "host": ["{{base_url}}"], "path": ["http", "b3splitter"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pedido\": {\n    \"numero\": \"PED-5001\",\n    \"itens\": {\n      \"item\": [\n        { \"produto\": \"Balança Industrial\", \"quantidade\": 2 },\n        { \"produto\": \"Etiqueta Térmica\", \"quantidade\": 100 },\n        { \"produto\": \"Impressora Zebra\", \"quantidade\": 5 }\n      ]\n    }\n  }\n}"
            },
            "description": "Lote com 3 itens dividido pelo Splitter em 3 mensagens individuais."
          }
        }
      ]
    }
  ]
}
